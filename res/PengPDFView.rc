#include <windows.h>
#include "resource.h"

IDI_APP_ICON            ICON        "app.ico"
1                       RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,1,1,0
 PRODUCTVERSION  1,1,1,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Peng"
            VALUE "FileDescription",  "Peng PDF View"
            VALUE "FileVersion",      "1.1.1.0"
            VALUE "InternalName",     "PengPDFView"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Peng"
            VALUE "OriginalFilename", "PengPDFView.exe"
            VALUE "ProductName",      "Peng PDF View"
            VALUE "ProductVersion",   "1.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
